# ==========================================
# 1. Pythonの標準キャッシュ・仮想環境
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# 仮想環境（ライブラリ本体が入るフォルダ）
venv/
.venv/
env/

# ==========================================
# 2. 環境変数・秘密情報
# ==========================================
# FlaskのSECRET_KEYやAPIキーなどを書き込むファイル
.env

# ==========================================
# 3. AI / 機械学習モデルの巨大ファイル（重要）
# ==========================================
# PyTorchやHugging Faceのモデル重みファイル（GitHubは100MB以上のファイルでエラーになります）
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ローカルに保存したモデルフォルダやキャッシュ
models/
checkpoints/
.cache/

# ==========================================
# 4. Playwright関連のファイル
# ==========================================
# スクリーンショット、テスト結果、ブラウザキャッシュなど
test-results/
playwright-report/
ms-playwright/

# ==========================================
# 5. OSやエディタ（VS Code等）の設定ファイル
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/